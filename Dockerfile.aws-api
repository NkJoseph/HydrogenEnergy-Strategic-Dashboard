# AWS API Service Dockerfile
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    HOST=0.0.0.0 \
    PORT=8000

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api.py .
COPY start_api.py .
COPY analysis_wrappers.py .
COPY config.py .
COPY global\ analysis.py .
COPY regional\ analysis.py .
COPY simple_train_models.py .

# Copy data directories (if they exist)
COPY pretrained-models/ ./pretrained-models/ 2>/dev/null || mkdir -p pretrained-models
COPY dataset/ ./dataset/ 2>/dev/null || mkdir -p dataset
COPY processed_data/ ./processed_data/ 2>/dev/null || mkdir -p processed_data

# Create necessary directories
RUN mkdir -p pretrained-models/global pretrained-models/regional \
    processed_data dataset

# Set permissions
RUN chmod +x start_api.py

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start API server
CMD ["python", "start_api.py"]
