# Ultra-minimal Dockerfile for 4GB limit
FROM python:3.11-alpine

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# Install minimal system dependencies
RUN apk add --no-cache \
    curl \
    ca-certificates

# Copy requirements first for better caching
COPY requirements-ultra-minimal.txt requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy only essential application code
COPY api.py .
COPY dashboard.py .
COPY start_api.py .
COPY start_dashboard_render.py .

# Create minimal directories (no large model files)
RUN mkdir -p pretrained-models/global pretrained-models/regional \
    processed_data dataset

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Start command (single service for minimal deployment)
CMD ["python", "dashboard.py"]
