# AWS Dashboard Service Dockerfile
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PORT=8050

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY dashboard.py .
COPY assets/ ./assets/ 2>/dev/null || mkdir -p assets

# Copy data directories (if they exist)
COPY pretrained-models/ ./pretrained-models/ 2>/dev/null || mkdir -p pretrained-models
COPY dataset/ ./dataset/ 2>/dev/null || mkdir -p dataset
COPY processed_data/ ./processed_data/ 2>/dev/null || mkdir -p processed_data

# Create necessary directories
RUN mkdir -p pretrained-models/global pretrained-models/regional \
    processed_data dataset assets

# Expose port
EXPOSE 8050

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8050/ || exit 1

# Start Dashboard server
CMD ["python", "dashboard.py"]
